{
  "name": "econ-sim",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @econ/client",
    "build": "npm run build -w @econ/client",
    "encyclopedia": "npm run dev -w @econ/encyclopedia",
    "reports": "vite tools/reports --port 5201",
    "test": "npm test -w @econ/sim",
    "test:core": "npm run test:core -w @econ/sim",
    "test:long": "npm run test:long -w @econ/sim",
    "golden:update": "npm run golden:update -w @econ/sim",
    "typecheck": "npm run typecheck -w @econ/sim && npm run typecheck -w @econ/client && npm run typecheck -w @econ/encyclopedia"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
