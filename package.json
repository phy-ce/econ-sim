{
  "name": "econ-sim",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @econ/client",
    "build": "npm run build -w @econ/client",
    "test": "npm test -w @econ/sim",
    "sim:run": "npm run run -w @econ/sim --",
    "typecheck": "npm run typecheck -w @econ/sim && npm run typecheck -w @econ/client"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
